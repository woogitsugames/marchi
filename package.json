{
  "name": "marchia",
  "private": true,
  "version": "0.1.0",
  "description": "MARCHIA — Szlaki Królestwa: a medieval logistics strategy game for mobile.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sim.json --noEmit",
    "test": "tsx tests/run.ts",
    "test:one": "tsx tests/run.ts",
    "bot": "tsx tools/mission-bot.ts",
    "perf:sim": "tsx tools/perf-sim.ts",
    "shots": "node tools/screenshots.mjs",
    "cap:sync": "npm run build && cap sync"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@types/node": "^22.20.5",
    "@types/three": "^0.181.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
