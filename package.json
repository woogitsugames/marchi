{
  "name": "marchia",
  "private": true,
  "version": "0.1.0",
  "description": "MARCHIA — Szlaki Królestwa: a medieval logistics strategy game for mobile.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && vite build --config vite.bench.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sim.json --noEmit",
    "test": "tsx tests/run.ts",
    "test:one": "tsx tests/run.ts",
    "test:known-failing": "tsx tests/known-failing/run.ts",
    "fuzz": "tsx tools/fuzz.ts",
    "bot": "tsx tools/mission-bot.ts",
    "perf:sim": "tsx tools/perf-sim.ts",
    "shots": "node tools/screenshots.mjs",
    "cap:sync": "npm run build && cap sync",
    "apk": "bash tools/build-apk.sh",
    "setup:android": "bash tools/setup-android-sdk.sh",
    "icons": "node tools/make-icons.mjs",
    "icons:check": "node tools/check-icons.mjs",
    "build:bench": "vite build --config vite.bench.config.ts",
    "layout": "node tools/layout-check.mjs",
    "i18n:coverage": "tsx tools/i18n-coverage.ts",
    "a11y": "node tools/a11y-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "~8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "@fontsource/ruslan-display": "^5.3.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.181.0",
    "fake-indexeddb": "^6.2.7",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
