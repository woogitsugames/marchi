<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (D-46): cloud backup and device-to-device transfer keep the saves and settings, drop the
     WebView caches. Same rules as backup_rules.xml for older versions. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/Default/GPUCache/" />
        <exclude domain="root" path="app_webview/Default/Code Cache/" />
        <exclude domain="root" path="app_webview/Default/Cache/" />
        <exclude domain="root" path="app_webview/Default/Service Worker/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/Default/GPUCache/" />
        <exclude domain="root" path="app_webview/Default/Code Cache/" />
        <exclude domain="root" path="app_webview/Default/Cache/" />
        <exclude domain="root" path="app_webview/Default/Service Worker/" />
    </device-transfer>
</data-extraction-rules>
